# Copy this file to .env and enter your local MySQL settings.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=job_tracker

# Use a long, random value for local development.
SECRET_KEY=replace_with_a_long_random_secret_key

# Optional settings
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO
